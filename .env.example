NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:6001

# Required to launch/cancel benchmarks and view logs. Use the BenchmarkApiUrl
# output from the benchmark stack in jumpserve-infra (without /benchmarks).
NEXT_PUBLIC_BENCHMARK_API_URL=

# Optional assessment/prompt catalogue API override for local backend development.
# Leave unset to use the configured research/benchmark API.
NEXT_PUBLIC_RESEARCH_CATALOG_API_URL=

# Required for AI chat. Use the AgentFunctionUrl output from JumpServeAgentStack.
NEXT_PUBLIC_AGENT_URL=

# Phase-one paper breakdown runs in Next.js. These keys are server-only.
OPENAI_API_KEY=
SUPABASE_SECRET_KEY=
# Legacy service-role keys are also accepted as SUPABASE_SERVICE_ROLE_KEY.

# Production: reference a Secrets Manager secret using the Amplify SSR compute role.
# The secret contains OPENAI_API_KEY and SUPABASE_SECRET_KEY; never embed them in build artifacts.
PAPER_INTAKE_SECRET_ID=
