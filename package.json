{
  "name": "jumpserve-front-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "verify:prompts": "node scripts/verify-prompts.mjs",
    "verify:platform": "node scripts/verify-platform-updates.mjs",
    "dev": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --port \"${PORT:-6001}\"",
    "build": "next build",
    "start": "next start --port \"${PORT:-6001}\"",
    "lint": "eslint",
    "test": "node --import ./tests/support/tsx-loader.mjs --test tests/*.test.mjs",
    "test:coverage:report": "node tests/run-coverage.mjs",
    "test:coverage": "node tests/run-coverage.mjs --check",
    "verify:http2": "node scripts/verify-http2-study.mjs",
    "ui:add": "shadcn add",
    "verify:research:public-queue": "node scripts/verify-public-experiment-queue.mjs",
    "verify:profile": "node scripts/verify-profile.mjs",
    "verify:auth": "node scripts/verify-browser-auth.mjs",
    "verify:paper-uploads": "node scripts/verify-paper-uploads.mjs",
    "verify:research:ideas": "node scripts/verify-research-ideas.mjs",
    "verify:research:autonomy": "node scripts/verify-research-autonomy.mjs",
    "verify:research:assessments:production": "node scripts/verify-assessment-navigation-production.mjs",
    "eval:paper": "node --import ./scripts/lib/register-typescript.mjs scripts/evaluate-paper-intake.mjs",
    "eval:experiment-plan": "node --import ./scripts/lib/register-typescript.mjs scripts/evaluate-experiment-plan.mjs",
    "verify:paper": "node --import ./scripts/lib/register-typescript.mjs scripts/verify-paper-intake.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1132.0",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.8",
    "openai": "7.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/mcp-server-supabase": "0.16.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "c8": {
      "test-exclude": {
        "glob": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  }
}
