{
  "name": "jumpserve-front-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --port \"${PORT:-6001}\"",
    "build": "next build",
    "start": "next start --port \"${PORT:-6001}\"",
    "lint": "eslint",
