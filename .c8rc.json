{
  "all": true,
  "include": ["app/**/*.ts", "app/**/*.tsx", "lib/**/*.ts", "proxy.ts", "*.config.ts", "*.config.mjs"],
  "exclude": ["**/*.d.ts"],
  "extension": [".ts", ".tsx", ".mjs"],
  "reporter": ["text-summary", "json", "json-summary", "lcov", "html"],
  "reports-dir": "coverage/unit",
  "lines": 100,
  "branches": 100,
  "functions": 100,
  "statements": 100,
  "per-file": true
}
