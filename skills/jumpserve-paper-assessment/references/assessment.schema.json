{
  "title": "JumpServe paper assessment bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "paper",
    "summary",
    "claims",
    "methods",
    "runs",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": "jumpserve-assessment-v1"
    },
    "skill_instructions": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version_id", "sha256"],
          "properties": {
            "source": { "const": "supabase" },
            "version_id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "sha256"],
          "properties": {
            "source": { "enum": ["bundled", "candidate"] },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "domain",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 50
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "pdf_copy": {
          "description": "Attach a verified copy of the assessed PDF to the owner-reviewed assessment.",
          "const": true
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "wizard": {
      "description": "Paper breakdown, ordered experiment plans, shareable local commands and script files for assessment Steps 2 through 4.",
      "type": "object",
      "additionalProperties": false,
      "required": ["breakdown", "experiments"],
      "properties": {
        "breakdown": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "description", "pages"],
            "properties": {
              "section": { "enum": ["access", "experiment", "data", "validate"] },
              "id": {
                "description": "Identifier unique within this section. Use it when another step references this one as its parent.",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
              },
              "parent_id": {
                "description": "ID of the enclosing step in the same section. Omit for a top-level step.",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "pages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          }
        },
        "experiments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "claim_ids", "prerequisites", "steps"],
            "properties": {
              "id": {
                "description": "Stable identifier unique among the planned experiments. Set it when a run references this experiment.",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 300 },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 40 }
              },
              "prerequisites": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "setup": { "type": "string", "minLength": 1, "maxLength": 12000 },
              "cleanup": { "type": "string", "minLength": 1, "maxLength": 12000 },
              "command_notes": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "scripts": {
                "description": "Complete UTF-8 script files used by the setup, run, analysis or cleanup commands.",
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "content"],
                  "properties": {
                    "path": {
                      "description": "File path relative to the experiment directory.",
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
                    },
                    "content": { "type": "string", "minLength": 1, "maxLength": 64000 }
                  }
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "instructions"],
                  "properties": {
                    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
                    "instructions": { "type": "string", "minLength": 1, "maxLength": 2000 },
                    "commands": { "type": "string", "minLength": 1, "maxLength": 12000 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "claim",
          "criterion",
          "outcome",
          "finding"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "outcome": {
            "enum": [
              "untested",
              "inconclusive",
              "reproduced",
              "discrepant"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "minItems": 1,
      "maxItems": 50
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "procedure"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "procedure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "commands": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      },
      "minItems": 0,
      "maxItems": 30
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "configuration",
          "started_at",
          "artifact_sha256",
          "measurements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$"
          },
          "experiment_id": {
            "description": "The saved experiment ID for this run. Use it to report measurements under the correct experiment, especially when experiments test the same claims.",
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
          },
          "configuration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "started_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_id",
                "metric",
                "units",
                "paper_value",
                "observed_value"
              ],
              "properties": {
                "claim_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$"
                },
                "metric": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "units": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "paper_value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "observed_value": {
                  "type": "number"
                }
              }
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "minItems": 0,
      "maxItems": 20
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
